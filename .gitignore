# Dependencias (se reinstalan con npm install)
node_modules/

# Secretos y configuración local (usar .env.example como plantilla)
.env
.env.*
!.env.example

# Base de datos local (se genera con npm run init-db)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Archivos que Postman genera solo (pueden guardar contraseña o token).
# La colección que se entrega es postman/Taller_API_Libros.postman_collection.json
.postman/
postman/collections/
postman/globals/
postman/environments/

# Logs
*.log
npm-debug.log*

# Entregable comprimido
*.zip

# Sistema y editor
.DS_Store
Thumbs.db
.vscode/
.idea/
