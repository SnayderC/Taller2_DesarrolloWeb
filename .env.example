# Copiar a .env y completar. No subir .env a ningun lugar.
PORT=3000
DB_PATH=./data/libros.db
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_ALEATORIO
JWT_EXPIRES_IN=15m
# Cuenta de prueba creada por: npm run init-db
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_CONTRASENA_DE_PRUEBA
